+/* Aetheris v2 design tokens — shared by all click dummies.
+   Production CSS in src/Aetheris.Web/wwwroot/css/app.css must stay in sync. */
+:root {
+  --bg: #090D16;
+  --surface: #1E293B;
+  --surface-2: #0F172A;
+  --primary: #6366F1;
+  --violet: #A855F7;
+  --cyan: #06B6D4;
+  --emerald: #10B981;
+  --amber: #F59E0B;
+  --red: #EF4444;
+  --text: #E2E8F0;
+  --muted: #94A3B8;
+  --border: rgba(148, 163, 184, 0.16);
+  --radius: 14px;
+}
+* { box-sizing: border-box; margin: 0; }
+html, body { height: 100%; }
+body {
+  background: var(--bg); color: var(--text);
+  font-family: 'Inter', 'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif;
+  font-size: 14px;
+}
+code, .mono { font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace; }
+a { color: var(--cyan); }
+
+.card {
+  background: linear-gradient(180deg, rgba(30,41,59,.82), rgba(15,23,42,.95));
+  border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;
+}
+.btn {
+  border: 1px solid var(--border); background: var(--surface); color: var(--text);
+  padding: 9px 16px; border-radius: 10px; cursor: pointer; font-size: 13px; font-family: inherit;
+}
+.btn:hover { border-color: var(--primary); }
+.btn.primary { background: linear-gradient(135deg, var(--primary), var(--violet)); border: none; font-weight: 600; }
+.btn.ghost { background: transparent; }
+.btn:disabled { opacity: .4; cursor: default; }
+.chip {
+  display: inline-block; font-size: 11px; padding: 3px 9px; border-radius: 999px;
+  background: rgba(99,102,241,.15); color: var(--primary); border: 1px solid rgba(99,102,241,.35);
+}
+.chip.cyan { background: rgba(6,182,212,.12); color: var(--cyan); border-color: rgba(6,182,212,.35); }
+.chip.green { background: rgba(16,185,129,.12); color: var(--emerald); border-color: rgba(16,185,129,.35); }
+.chip.amber { background: rgba(245,158,11,.12); color: var(--amber); border-color: rgba(245,158,11,.35); }
+.muted { color: var(--muted); } .small { font-size: 12px; }
+input, select, textarea {
+  width: 100%; padding: 10px 12px; border-radius: 10px; font-family: inherit; font-size: 13px;
+  border: 1px solid var(--border); background: var(--surface-2); color: var(--text);
+}
+input:focus, select:focus { outline: none; border-color: var(--primary); }
+label { display: block; font-size: 11px; color: var(--muted); margin: 10px 0 4px; text-transform: uppercase; letter-spacing: .06em; }
+
+.icon-dot {
+  width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center;
+  font-size: 13px; font-weight: 700; color: #fff; flex: none;
+}
+.dot-password { background: linear-gradient(135deg, var(--primary), var(--violet)); }
+.dot-apikey   { background: linear-gradient(135deg, var(--cyan), #0891B2); }
+.dot-note     { background: linear-gradient(135deg, var(--emerald), #059669); }
+.dot-ssh      { background: linear-gradient(135deg, var(--amber), #D97706); }
+.dot-card     { background: linear-gradient(135deg, #F43F5E, #E11D48); }
+
+.toast {
+  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
+  background: var(--surface); border: 1px solid var(--emerald); color: var(--emerald);
+  padding: 9px 18px; border-radius: 999px; font-size: 13px; display: none; z-index: 99;
+}
+
+.grid { display: grid; gap: 12px; }
+.hidden { display: none !important; }
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { background: var(--surface); border-radius: 8px; }
