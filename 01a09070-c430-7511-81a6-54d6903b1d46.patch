+\x1bwarnclaude  88,450 / 100,000 tokens today  ████████░░ 88%
+\x1bkeylocal    unlimited (ollama)             · fallback ready`,
+];
+const ESC={cmd:'cmd',dim:'dim',ok:'ok',warn:'warn',key:'key'};
+function render(s){ const re=/\x1b(\w+)([^\x1b]*)/g; return s.replace(re,(m,c,t)=>`<span class="${ESC[c]}">${t}</span>`); }
+const term=document.getElementById('term'); let i=0;
+function paint(){ term.innerHTML = steps.slice(0,i+1).map(render).join('\n\n')+'\n\n<span class="cursor"></span>'; term.scrollTop=term.scrollHeight; }
+function next(){ if(i<steps.length-1){i++;paint();} else toast('end of demo — all of this runs from the v2 skeleton'); }
+function prev(){ if(i>0){i--;paint();} }
+function reset(){ i=0; term.innerHTML='<span class="dim"># click ▶ to step through the CLI story</span>\n<span class="cursor"></span>'; }
+function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.style.display='block'; setTimeout(()=>t.style.display='none',2600); }
