# =============================================================================
# Aetheris Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
AETH_ENV=development
AETH_LOG_LEVEL=info
AETH_LOG_FILE=aetheris.log
AETH_DATA_DIR=~/.aetheris
AETH_CONFIG_FILE=~/.aetheris/aetheris.toml

# -----------------------------------------------------------------------------
# Vault Encryption
# -----------------------------------------------------------------------------
# Master password is NEVER stored. This is the Argon2id cost parameter.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Sync (S3-Compatible)
# -----------------------------------------------------------------------------
AETH_SYNC_ENABLED=true
AETH_SYNC_PROVIDER=s3
AETH_SYNC_BUCKET=aetheris-vault
AETH_SYNC_REGION=us-east-1
AETH_SYNC_OBJECT_KEY=vault/blob.enc
AETH_SYNC_INTERVAL_SECONDS=300

# AWS credentials (or use IAM role / AWS_PROFILE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# For Backblaze B2
# AETH_SYNC_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AETH_SYNC_REGION=us-west-004

# For Cloudflare R2
# AETH_SYNC_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# For MinIO (self-hosted)
# AETH_SYNC_ENDPOINT=http://localhost:9000

# -----------------------------------------------------------------------------
# Web Server (for browser extension & web app)
# -----------------------------------------------------------------------------
AETH_WEB_ENABLED=false
AETH_WEB_HOST=127.0.0.1
AETH_WEB_PORT=18080
AETH_WEB_CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin / Auth (cloud-hosted mode)
# -----------------------------------------------------------------------------
AETH_AUTH_MODE=local
AETH_AUTH_JWT_SECRET=change-me-in-production
AETH_AUTH_JWT_EXPIRY_HOURS=24
AETH_AUTH_REGISTRATION_ENABLED=true

# -----------------------------------------------------------------------------
# Proactive Engine
# -----------------------------------------------------------------------------
AETH_PROACTIVE_ENABLED=true
AETH_PROACTIVE_ROTATION_CHECK_HOURS=6
AETH_PROACTIVE_BREACH_CHECK_DAYS=1
AETH_PROACTIVE_MONITOR_INTERVAL_MINUTES=30
AETH_PROACTIVE_BACKUP_DAYS=1
AETH_PROACTIVE_BACKUP_RETENTION_DAYS=30
AETH_PROACTIVE_CLEANUP_WEEKS=1

# -----------------------------------------------------------------------------
# SSH Client
# -----------------------------------------------------------------------------
AETH_SSH_TIMEOUT_SECONDS=30
AETH_SSH_KEEPALIVE_SECONDS=60
AETH_SSH_MAX_SESSIONS=10
AETH_SSH_KEY_TYPE=ed25519
AETH_SSH_KEY_BITS=256

# -----------------------------------------------------------------------------
# Browser Extension Relay
# -----------------------------------------------------------------------------
AETH_BROWSER_RELAY_ENABLED=false
AETH_BROWSER_RELAY_HOST=127.0.0.1
AETH_BROWSER_RELAY_PORT=18081
AETH_BROWSER_RELAY_TOKEN=auto-generated-on-startup

# -----------------------------------------------------------------------------
# i18n / Localization
# -----------------------------------------------------------------------------
AETH_LOCALE=en
AETH_LOCALE_FALLBACK=en
AETH_LOCALE_DIR=./locales

# -----------------------------------------------------------------------------
# Debug / Development
# -----------------------------------------------------------------------------
AETH_DEBUG=false
AETH_DEBUG_UI=false
AETH_METRICS_ENABLED=false
AETH_METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Platform-Specific
# -----------------------------------------------------------------------------
# Windows
# AETH_WINDOWS_TRAY_ENABLED=true
# AETH_WINDOWS_STARTUP_ENABLED=false

# macOS
# AETH_MACOS_TRAY_ENABLED=true
# AETH_MACOS_TOUCH_ID_ENABLED=true
# AETH_MACOS_KEYCHAIN_SERVICE=aetheris

# Linux
# AATH_LINUX_KEYRING_SERVICE=aetheris
# AETH_LINUX_SECRET_SERVICE=true

# iOS
# AETH_IOS_KEYCHAIN_GROUP.com.aetheris.shared
# AETH_IOS_BIOMETRIC_ENABLED=true

# Android
# AETH_ANDROID_KEYSTORE_ALIAS=aetheris_master
# AETH_ANDROID_BIOMETRIC_ENABLED=true
