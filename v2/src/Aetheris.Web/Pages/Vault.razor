@page "/vault"
@inject VaultState State
@inject NavigationManager Nav

@if (!State.IsUnlocked)
{
    <div class="center-screen">
        <div class="card unlock-card">
            <div class="brand-badge big">🔒</div>
            <h1>Vault locked</h1>
            <p class="muted">Please <a href="/">unlock</a> to access your vault.</p>
        </div>
    </div>
}
else
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-badge">◈</span> Aetheris
                <span class="brand-sub">v2</span>
            </div>
            <nav class="nav">
                <NavLink href="vault" Match="NavLinkMatch.All">🗄 Vault</NavLink>
                <NavLink href="gateway">⚡ Gateway</NavLink>
                <NavLink href="settings">⚙ Settings</NavLink>
            </nav>
            <div class="sidebar-foot muted small">
                @if (State.IsHubReachable)
                {
                    <span>✓ Hub reachable</span>
                }
                else
                {
                    <span>⚠ Hub offline</span>
                }
                <br />
                <span>gen @State.CurrentGeneration</span>
                @if (State.HasUnsavedChanges)
                {
                    <span style="color: var(--emerald);">· unsaved</span>
                }
            </div>
        </aside>
        
        <main class="content">
            <header class="page-head">
                <h1>Vault</h1>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input class="search" 
                           placeholder="search…" 
                           @bind="_searchQuery" 
                           @bind:event="oninput" 
                           @oninput="FilterItems" />
                    <button class="btn primary" @onclick="ShowAddItem">+ Add item</button>
                    <button class="btn" @onclick="SyncVault" disabled="@(!State.HasUnsavedChanges)">
                        @if (_isSyncing)
                        {
                            <span>Syncing…</span>
                        }
                        else
                        {
                            <span>Sync</span>
                        }
                    </button>
                </div>
            </header>

            @if (_showAddItem)
            {
                <AddItemModal OnClose="HideAddItem" OnSave="AddNewItem" />
            }

            @if (_editingItem != null)
            {
                <EditItemModal Item="_editingItem" OnClose="CancelEdit" OnSave="SaveEditedItem" />
            }

            @if (State.FilteredItems.Count == 0)
            {
                <div class="card" style="text-align: center; padding: 40px;">
                    <div class="brand-badge big" style="font-size: 48px; margin-bottom: 12px;">📦</div>
                    <h3>No items found</h3>
                    @if (!string.IsNullOrEmpty(_searchQuery))
                    {
                        <p class="muted small">No items match "@_searchQuery"</p>
                    }
                    else
                    {
                        <p class="muted small">Your vault is empty. Add your first item!</p>
                    }
                </div>
            }
            else
            {
                <div class="item-grid">
                    @foreach (var item in State.FilteredItems)
                    {
                        <div class="card item-card" @onclick="() => ShowItemDetail(item)" style="cursor: pointer;">
                            <div style="display: flex; align-items: flex-start; gap: 12px;">
                                <span class="item-icon">@GetItemIcon(item.Type)</span>
                                <div style="flex: 1; min-width: 0;">
                                    <h3 style="margin: 0 0 4px;">@item.Title</h3>
                                    <p class="muted small">
                                        @if (!string.IsNullOrEmpty(item.Username))
                                        {
                                            <span>@item.Username</span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.Url))
                                        {
                                            <span>@GetDomain(item.Url)</span>
                                        }
                                        else
                                        {
                                            <span>@item.Type</span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div style="display: flex; gap: 8px; margin-top: 12px; justify-content: flex-end;">
                                <button class="btn small" @onclick:stopPropagation="() => CopyPassword(item)" title="Copy password">
                                    📋
                                </button>
                                <button class="btn small" @onclick:stopPropagation="() => EditItem(item)" title="Edit">
                                    ✏️
                                </button>
                                <button class="btn small" @onclick:stopPropagation="() => ConfirmDeleteItem(item)" title="Delete" style="color: #ef4444;">
                                    🗑️
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(item.TotpSecret))
                            {
                                <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border);">
                                    <span class="muted small">TOTP: </span>
                                    <span class="mono" style="color: var(--cyan); font-weight: 600;">@_totpCodes.GetValueOrDefault(item.Id, "...")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </main>
    </div>
}

@code {
    private string _searchQuery = "";
    private bool _showAddItem = false;
    private VaultItem? _editingItem = null;
    private bool _isSyncing = false;
    private readonly Dictionary<string, string> _totpCodes = new();
    private System.Timers.Timer? _totpTimer;

    protected override async Task OnInitializedAsync()
    {
        StartTotpTimer();
        await RefreshTotpCodesAsync();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            StopTotpTimer();
        }
        base.Dispose(disposing);
    }

    private void FilterItems()
    {
        State.FilterItems(_searchQuery);
        StateHasChanged();
    }

    private void ShowAddItem() => _showAddItem = true;
    private void HideAddItem() => _showAddItem = false;

    private void EditItem(VaultItem item) => _editingItem = item;
    private void CancelEdit() => _editingItem = null;

    private async Task AddNewItem(VaultItem item)
    {
        State.AddItem(item);
        _showAddItem = false;
        await RefreshTotpCodesAsync();
        StateHasChanged();
    }

    private async Task SaveEditedItem(VaultItem item)
    {
        State.UpdateItem(item);
        _editingItem = null;
        await RefreshTotpCodesAsync();
        StateHasChanged();
    }

    private void ConfirmDeleteItem(VaultItem item)
    {
        if (confirm("Are you sure you want to delete this item?"))
        {
            State.DeleteItem(item.Id);
            _totpCodes.Remove(item.Id);
            StateHasChanged();
        }
    }

    private async Task SyncVault()
    {
        _isSyncing = true;
        StateHasChanged();
        
        try
        {
            await State.PushAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task CopyPassword(VaultItem item)
    {
        var text = item.Password ?? item.Username ?? item.Title;
        await State.CopyToClipboardAsync(text);
    }

    private void ShowItemDetail(VaultItem item)
    {
        Nav.NavigateTo($"/vault/{item.Id}");
    }

    private string GetItemIcon(string type) => type switch
    {
        "Password" => "🔑",
        "ApiKey" => "🪄",
        "Note" => "📝",
        "Card" => "💳",
        "Identity" => "👤",
        _ => "📦"
    };

    private string GetDomain(string url)
    {
        try
        {
            return new Uri(url).Host;
        }
        catch
        {
            return url;
        }
    }

    private void StartTotpTimer()
    {
        StopTotpTimer();
        _totpTimer = new System.Timers.Timer(1000); // Refresh every second
        _totpTimer.Elapsed += async (sender, e) => await RefreshTotpCodesAsync();
        _totpTimer.AutoReset = true;
        _totpTimer.Start();
    }

    private void StopTotpTimer()
    {
        if (_totpTimer != null)
        {
            _totpTimer.Stop();
            _totpTimer.Elapsed -= async (sender, e) => await RefreshTotpCodesAsync();
            _totpTimer.Dispose();
            _totpTimer = null;
        }
    }

    private async Task RefreshTotpCodesAsync()
    {
        var itemsWithTotp = State.Items.Where(i => !string.IsNullOrEmpty(i.TotpSecret)).ToList();
        
        foreach (var item in itemsWithTotp)
        {
            var code = await State.GetTotpCodeAsync(item.Id);
            if (code != null)
            {
                _totpCodes[item.Id] = code;
            }
        }
        
        StateHasChanged();
    }
}
