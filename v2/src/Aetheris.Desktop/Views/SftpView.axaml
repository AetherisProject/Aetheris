<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aetheris.Desktop.ViewModels"
             x:Class="Aetheris.Desktop.Views.SftpView">
    
    <Grid RowDefinitions="Auto,1*,Auto,Auto" ColumnDefinitions="1*,1*">
        <!-- Connection Bar -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Stretch">
            <Button Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsBusy && !IsConnected}" Margin="0,0,10,0" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,10,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Text="{Binding TransferStatus}" VerticalAlignment="Center" Margin="20,0,0,0" />
        </StackPanel>

        <!-- Remote Path -->
        <Border Grid.Row="1" Grid.Column="0" Margin="10,0,5,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Remote: " VerticalAlignment="Center" />
                <TextBox Text="{Binding CurrentPath, Mode=TwoWay}" Width="*" />
            </StackPanel>
        </Border>

        <!-- Local Path -->
        <Border Grid.Row="1" Grid.Column="1" Margin="5,0,10,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Local: " VerticalAlignment="Center" />
                <TextBox Text="{Binding LocalPath, Mode=TwoWay}" Width="*" />
            </StackPanel>
        </Border>

        <!-- Remote Files -->
        <Border Grid.Row="2" Grid.Column="0" Margin="10,0,5,0" BorderBrush="{DynamicResource ThemeBrush-GrayBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid Items="{Binding RemoteItems}" 
                          SelectedItem="{Binding SelectedRemoteItem}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding IsDirectory, Converter={StaticResource BoolToTypeConverter}}" Width="Auto" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:N0} bytes'}" Width="Auto" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>

        <!-- Local Files -->
        <Border Grid.Row="2" Grid.Column="1" Margin="5,0,10,0" BorderBrush="{DynamicResource ThemeBrush-GrayBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid Items="{Binding LocalItems}" 
                          SelectedItem="{Binding SelectedLocalItem}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding IsDirectory, Converter={StaticResource BoolToTypeConverter}}" Width="Auto" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:N0} bytes'}" Width="Auto" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>

        <!-- Transfer Controls -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <Button Content="Download" Command="{Binding DownloadCommand}" IsEnabled="{Binding SelectedRemoteItem != null && IsConnected}" Margin="0,0,20,0" />
            <Button Content="Upload" Command="{Binding UploadCommand}" IsEnabled="{Binding SelectedLocalItem != null && IsConnected}" Margin="0,0,20,0" />
            <Button Content="Delete Remote" Command="{Binding DeleteRemoteCommand}" IsEnabled="{Binding SelectedRemoteItem != null && IsConnected}" />
        </StackPanel>
    </Grid>
</UserControl>