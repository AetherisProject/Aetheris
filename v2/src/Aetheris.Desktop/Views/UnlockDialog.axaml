<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aetheris.Desktop.ViewModels"
        x:Class="Aetheris.Desktop.Views.UnlockDialog"
        Title="Unlock Vault"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Unlock Aetheris Vault" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20" />

        <!-- Password Input -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Master Password:" Margin="0,0,0,5" />
            <PasswordBox Password="{Binding Password, Mode=TwoWay}" 
                         Watermark="Enter master password..." 
                         PasswordChar="•" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" Width="80" />
            <Button Content="Unlock" Command="{Binding UnlockCommand}" IsDefault="True" Width="80" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,0" 
                   IsVisible="{Binding HasError}" />
    </Grid>
</Window>