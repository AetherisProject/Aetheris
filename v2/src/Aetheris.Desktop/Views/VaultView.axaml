<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aetheris.Desktop.ViewModels"
             x:Class="Aetheris.Desktop.Views.VaultView">
    
    <Grid RowDefinitions="Auto,1*,Auto" ColumnDefinitions="*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Stretch">
            <TextBox Watermark="Search..." Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" Margin="0,0,10,0" />
            <Button Content="Add" Command="{Binding AddItemCommand}" Margin="0,0,10,0" />
            <Button Content="Edit" Command="{Binding EditItemCommand}" IsEnabled="{Binding SelectedItem != null}" Margin="0,0,10,0" />
            <Button Content="Delete" Command="{Binding DeleteItemCommand}" IsEnabled="{Binding SelectedItem != null}" Margin="0,0,10,0" />
            <Button Content="Copy Password" Command="{Binding CopyPasswordCommand}" IsEnabled="{Binding SelectedItem != null}" />
        </StackPanel>

        <!-- Items List -->
        <Grid Grid.Row="1" Margin="10">
            <DataGrid Items="{Binding Items}" 
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="Auto" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="Auto" />
                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status -->
        <StatusBar Grid.Row="2">
            <StatusBar.Items>
                <StatusBarItem>
                    <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}" />
                </StatusBarItem>
            </StatusBar.Items>
        </StatusBar>
    </Grid>
</UserControl>